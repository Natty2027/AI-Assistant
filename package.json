{
  "name": "cyber-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx build.ts",
    "build:chrome": "tsx build.ts chrome",
    "build:edge": "tsx build.ts edge",
    "build:firefox": "tsx build.ts firefox",
    "build:safari": "tsx build.ts safari",
    "build:mock": "API_BASE=http://localhost:4000 tsx build.ts chrome",
    "mock": "node scripts/mock-server.mjs",
    "dev": "bash scripts/dev-chrome.sh",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke:models": "node scripts/smoke-models.mjs",
    "test:host": "python3 -m unittest discover -s native-host -p 'test_*.py'",
    "e2e:apps": "tsx build.ts chrome && node scripts/e2e-apps.mjs",
    "check": "npm run typecheck && npm run test && npm run test:host && npm run build",
    "start": "tsx server/index.ts",
    "deck": "node deck/build-deck.mjs",
    "deck:preview": "node deck/preview.mjs",
    "deck:screens": "API_BASE=http://127.0.0.1:4471 tsx build.ts chrome && node deck/capture-screens.mjs; s=$?; tsx build.ts chrome; exit $s",
    "e2e:signals": "tsx build.ts chrome && node scripts/e2e-signals.mjs",
    "e2e:panel": "API_BASE=http://127.0.0.1:4470 tsx build.ts chrome && node scripts/e2e-panel.mjs; s=$?; tsx build.ts chrome; exit $s"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "pg": "^8.11.0",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "pptxgenjs": "4.0.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "image-size": "^2.0.3"
  }
}
