{
  "manifest_version": 3,
  "name": "Ambient Cyber Companion",
  "version": "0.1.0",
  "description": "A quiet calendar companion that stays out of your way.",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel", "storage", "alarms", "idle", "contextMenus",
    "identity", "notifications", "nativeMessaging"
  ],
  "optional_permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://graph.microsoft.com/*"
  ],
  "background": { "service_worker": "sw.js", "type": "module" },
  "side_panel": { "default_path": "ui/sidepanel.html" },
  "options_ui": { "page": "ui/options.html", "open_in_tab": true },
  "action": { "default_title": "Ambient Cyber Companion" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Open the panel"
    },
    "toggle-mute": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Mute or unmute"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'"
  },
  "icons": { "128": "icons/128.png" },

  "_safari_notes": [
    "Safari Web Extension has no sidePanel API. On macOS the panel renders in the toolbar popover; on iOS it renders as a full-screen popup from the extension button.",
    "iOS has no native messaging, so quietMode.ts loses the os_focus source entirely and falls back to calendar + heuristics. It fails quiet by design.",
    "chrome.idle is unavailable on iOS. probeIdle() returns null and contributes nothing.",
    "Run: xcrun safari-web-extension-converter ./ext --macos-only=false"
  ]
}
