# Dependencies and build output: both are recreated by `npm install` and `npm run build`.
node_modules/
dist/

# Secrets. Real values live only in the host's environment; .env.example documents the names.
.env
.env.*
!.env.example

# A throwaway browser profile used for local previews (cookies, caches, local storage).
.preview-profile/
screenshots/

# Generated by `npm run deck:preview`; the deck itself and its source images are kept.
deck/preview/
# Office lock file that exists while the deck is open in PowerPoint or Keynote.
deck/~$*

# Users' website files, written by the assistant at runtime. Never commit people's content.
data/

# Local noise.
.DS_Store
*.log
*.tmp

# Xcode per-user state and local builds.
xcuserdata/
*.xcuserstate
DerivedData/
build/
