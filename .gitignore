# Dependencies and build output: both are recreated by `npm install` and `npm run build`.
node_modules/
dist/

# Secrets. Real values live only in the host's environment; .env.example documents the names.
.env
.env.*
!.env.example

# Users' website files, written by the assistant at runtime. Never commit people's content.
data/

# Local noise.
.DS_Store
*.log
*.tmp

# Xcode per-user state and local builds.
xcuserdata/
*.xcuserstate
DerivedData/
build/
