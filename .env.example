# Copy to .env for local runs; on Railway, set these under Variables. Never commit real values.

# --- Required for the AI features (capture, moderation) ---
ANTHROPIC_API_KEY=

# --- Database: a Supabase project's connection string (the schema depends on auth.users,
#     auth.uid() and supabase_vault, so plain Railway Postgres will not run db/schema.sql) ---
DATABASE_URL=
# CA certificate (PEM) from Supabase > Project Settings > Database > SSL. With it the server
# verifies the database's identity; without it the link is encrypted but not authenticated.
# Paste as one line with \n for line breaks.
DATABASE_CA=

# --- Auth ---
# Staging: a long random secret. Paste the same value into the app's Settings as the access token.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TEST_ACCESS_TOKEN=
# An existing row in auth.users that the test token acts as.
TEST_USER_ID=
# Real sign-in (later): Supabase Project Settings > API > JWT Secret.
SUPABASE_JWT_SECRET=
# Local development ONLY. The server refuses to boot with this set on Railway.
DEV_USER_ID=

# --- OAuth token encryption: 32 random bytes, base64 ---
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# --- Calendar providers (optional until you test connecting a calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- CORS: only needed for browser clients. The native app doesn't use CORS. ---
ALLOWED_ORIGINS=
# Leave unset/0.
ALLOW_ANY_ORIGIN=0
