# Copy to .env for local runs; on Railway, set these under Variables. Never commit real values.

# --- AI: the assistant runs on Claude. Without it the server boots but can't run the assistant. ---
ANTHROPIC_API_KEY=

# --- Database: a Supabase project's connection string (the schema depends on auth.users,
#     auth.uid() and supabase_vault, so plain Railway Postgres will not run db/schema.sql) ---
DATABASE_URL=
# CA certificate (PEM) from Supabase > Project Settings > Database > SSL. With it the server
# verifies the database's identity; without it the link is encrypted but not authenticated.
# Paste as one line with \n for line breaks.
DATABASE_CA=

# --- Sign-in (Supabase Auth with Sign in with Apple) ---
# The project URL, e.g. https://abcd.supabase.co. Lets the server verify sign-ins with the
# project's signing keys, and close a person's sign-in account when they delete their account.
SUPABASE_URL=
# Server only, never in the app: used to delete a person's sign-in account at their request.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, for projects that still sign with the legacy shared secret (Settings > JWT Keys).
SUPABASE_JWT_SECRET=

# --- Staging and local testing only. Leave all three unset in production. ---
# A long random secret (32+ characters). Paste the same value into the app's Settings as the
# developer token.   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TEST_ACCESS_TOKEN=
# An existing row in auth.users that the test token acts as.
TEST_USER_ID=
# Local development ONLY. The server refuses to boot with this set on Railway.
DEV_USER_ID=

# --- Encryption of every connection's token (Netlify, Bluesky, X, Meta): 32 random bytes, base64 ---
#   openssl rand -base64 32      Back it up: if it's lost, every connection must be redone.
MASTER_KEY=

# --- Public pages ---
# Shown on /support, /privacy and /terms.
SUPPORT_EMAIL=

# --- Where the assistant keeps each person's website files. On Railway, a mounted volume. ---
AGENT_SITES_DIR=/data/sites
# Photos attached to posts. Defaults to "media" next to the sites folder (same volume).
# AGENT_MEDIA_DIR=/data/media

# --- Posting to X, Facebook and Instagram. See docs/SOCIAL-SETUP.md for the developer apps. ---
# This server's public https address, no trailing slash. The sign-in return addresses are
# <PUBLIC_URL>/oauth/callback/x and <PUBLIC_URL>/oauth/callback/meta.
PUBLIC_URL=
# X developer portal -> your app -> Keys and tokens -> OAuth 2.0 Client ID and Client Secret.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Meta for Developers -> your app -> App settings -> Basic -> App ID and App secret.
META_APP_ID=
META_APP_SECRET=
# Business-type Meta apps: the Configuration ID from Facebook Login for Business → Configurations.
META_CONFIG_ID=

# --- CORS: only needed for browser clients. The native app doesn't use CORS. ---
ALLOWED_ORIGINS=
# Leave unset/0.
ALLOW_ANY_ORIGIN=0
